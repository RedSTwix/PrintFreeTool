<Window x:Class="PrintFreeTool.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintFreeTool"
        Width="390"
        SizeToContent="Height"
        MaxHeight="190"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Opacity="0"
        Loaded="OnLoaded"
        MouseLeftButtonUp="OnMouseLeftButtonUp">
    <Border Margin="12"
            Padding="16"
            Background="#F2141722"
            BorderBrush="#454B63"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StatusIconBackground"
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    CornerRadius="10"
                    Background="#6366F1">
                <TextBlock x:Name="StatusIcon"
                           Text="✓"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="4,0,10,0">
                <TextBlock x:Name="TitleText"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Margin="0,4,0,0"
                           Foreground="#A9ADC1"
                           FontSize="11.5"
                           LineHeight="17"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="54" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="×"
                       Foreground="#83889C"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top" />
        </Grid>
    </Border>
</Window>
