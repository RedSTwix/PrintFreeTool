<Window x:Class="PrintFreeTool.PrintScreenSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Print Screen"
        Width="610" Height="700" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4CC9F0" Offset="0" /><GradientStop Color="#6366F1" Offset="0.55" /><GradientStop Color="#A855F7" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="32" /><Setter Property="Foreground" Value="#A9ADC1" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#292D3D" /><Setter Property="Foreground" Value="White" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="46" /><Setter Property="Padding" Value="24,0" /><Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="72" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Foreground" Value="White" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Background="#1B1E2B" BorderBrush="#303548" BorderThickness="1" CornerRadius="14" Padding="16,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="19" Height="19" VerticalAlignment="Center"><Ellipse Stroke="#656B80" StrokeThickness="1.5" /><Ellipse x:Name="Dot" Width="9" Height="9" Fill="#7477FF" Visibility="Collapsed" /></Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#202331" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#696CFF" /><Setter TargetName="Card" Property="Background" Value="#20243A" /><Setter TargetName="Dot" Property="Visibility" Value="Visible" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="MonitorCheck" TargetType="CheckBox">
            <Setter Property="Height" Value="62" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Foreground" Value="White" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Row" Background="#181B27" BorderBrush="#292E40" BorderThickness="1" CornerRadius="12" Padding="14,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="19" Height="19" Background="#202432" BorderBrush="#555B70" BorderThickness="1.5" CornerRadius="5" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M3,7 L6,10 L12,3" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Width="12" Height="10" Stretch="Fill" />
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1E2230" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#6366F1" /><Setter TargetName="Box" Property="BorderBrush" Value="#8B8DFF" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="#141722" BorderBrush="#303448" BorderThickness="1" CornerRadius="22">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.5" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="20,0,16,0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <Viewbox Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M3,4 L21,4 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Configurar Print Screen" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Escolha quais telas entram na captura imediata" Foreground="#858AA0" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Click="OnCancelClick" ToolTip="Fechar">
                    <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Fill" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="30,10,30,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <RadioButton x:Name="AllScreensRadio" GroupName="CaptureMode" Style="{StaticResource ModeRadio}" Checked="OnModeChanged">
                    <StackPanel><TextBlock Text="Todas as telas" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="AllScreensDescription" Text="Une todos os monitores em uma única imagem" Foreground="#858BA0" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="SelectedScreensRadio" Grid.Row="1" GroupName="CaptureMode" Style="{StaticResource ModeRadio}" Checked="OnModeChanged">
                    <StackPanel><TextBlock Text="Somente as telas selecionadas" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Pode ser uma tela ou qualquer combinação" Foreground="#858BA0" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                </RadioButton>

                <RadioButton x:Name="SeparateScreensRadio" Grid.Row="2" GroupName="CaptureMode" Style="{StaticResource ModeRadio}" Checked="OnModeChanged">
                    <StackPanel><TextBlock Text="Cada tela em arquivo separado" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Cria uma imagem individual para cada monitor" Foreground="#858BA0" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                </RadioButton>

                <TextBlock Grid.Row="3" Text="TELAS DISPONÍVEIS" Foreground="#73798E" FontSize="10" FontWeight="Bold" Margin="3,7,0,10" />
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" MaxHeight="190">
                    <StackPanel x:Name="MonitorListPanel" />
                </ScrollViewer>

                <TextBlock x:Name="ValidationText" Grid.Row="5" Foreground="#FF8B94" FontSize="11" Margin="3,8,0,10" Visibility="Collapsed" />

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ActionButton}" Background="#222635" Content="Cancelar" Click="OnCancelClick" />
                    <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="Aplicar" Click="OnApplyClick" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
