<Window x:Class="PrintFreeTool.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de captura — PrintFreeTool"
        Width="1120" Height="760" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent"
        PreviewKeyDown="OnEditorPreviewKeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4CC9F0" Offset="0" />
            <GradientStop Color="#6366F1" Offset="0.55" />
            <GradientStop Color="#A855F7" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#A9ADC1" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#292D3D" /><Setter Property="Foreground" Value="White" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="88" /><Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="9,0" /><Setter Property="Margin" Value="3,0" />
            <Setter Property="Foreground" Value="#ADB2C5" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#252938" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.32" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Height" Value="44" /><Setter Property="MinWidth" Value="112" /><Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#EDEEF5" /><Setter Property="Background" Value="#242837" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ColorButton" TargetType="Button">
            <Setter Property="Width" Value="27" /><Setter Property="Height" Value="27" /><Setter Property="Margin" Value="4,0" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="3">
                    <Ellipse Fill="{TemplateBinding Background}" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#141722" BorderBrush="#303448" BorderThickness="1" CornerRadius="20">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.52" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="4" Height="2" Margin="28,0" VerticalAlignment="Top" CornerRadius="1" Background="{StaticResource AccentBrush}" Panel.ZIndex="20" />

            <Grid Margin="20,0,16,0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="✦" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Editor de captura" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImageInfoText" Text="Editar antes de salvar" Foreground="#858AA0" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Click="OnCloseClick" ToolTip="Descartar e fechar">
                    <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Fill" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#191C28" BorderBrush="#292D3D" BorderThickness="0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" /><ColumnDefinition Width="1" /><ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1" /><ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PenButton" Grid.Column="0" Style="{StaticResource ToolButton}" Click="OnPenClick" ToolTip="Caneta">
                        <StackPanel Orientation="Horizontal"><Path Data="M3,17 L7,16 L18,5 C18.8,4.2 18.8,3.2 18,2.4 L17.6,2 C16.8,1.2 15.8,1.2 15,2 L4,13 Z M12.8,4.2 L15.8,7.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" /><TextBlock Text="Caneta" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="HighlighterButton" Grid.Column="1" Style="{StaticResource ToolButton}" Click="OnHighlighterClick" ToolTip="Marca-texto">
                        <StackPanel Orientation="Horizontal"><Path Data="M4,15 L14,5 L18,9 L8,19 L3,19 Z M12,7 L16,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" /><TextBlock Text="Marca" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="EraserButton" Grid.Column="2" Style="{StaticResource ToolButton}" Click="OnEraserClick" ToolTip="Borracha">
                        <StackPanel Orientation="Horizontal"><Path Data="M4,14 L13,5 C13.8,4.2 15,4.2 15.8,5 L19,8.2 C19.8,9 19.8,10.2 19,11 L11,19 L6,19 L3.4,16.4 C2.7,15.7 3,15 4,14 Z M8,18 L13,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" /><TextBlock Text="Borracha" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </Button>

                    <Border Grid.Column="4" Background="#343849" Height="30" />

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ColorButton}" Background="#F43F5E" BorderBrush="White" Tag="#F43F5E" Click="OnColorClick" />
                        <Button Style="{StaticResource ColorButton}" Background="#F59E0B" Tag="#F59E0B" Click="OnColorClick" />
                        <Button Style="{StaticResource ColorButton}" Background="#22C55E" Tag="#22C55E" Click="OnColorClick" />
                        <Button Style="{StaticResource ColorButton}" Background="#38BDF8" Tag="#38BDF8" Click="OnColorClick" />
                        <Button Style="{StaticResource ColorButton}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnColorClick" />
                        <Button Style="{StaticResource ColorButton}" Background="#111827" Tag="#111827" Click="OnColorClick" />
                        <Button Style="{StaticResource ColorButton}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnColorClick" />
                    </StackPanel>

                    <Border Grid.Column="8" Background="#343849" Height="30" />

                    <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Espessura" Foreground="#777D92" FontSize="11" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <Slider x:Name="ThicknessSlider" Width="90" Minimum="2" Maximum="24" Value="6" TickFrequency="2" ValueChanged="OnThicknessChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="12" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="OnUndoClick" ToolTip="Desfazer" IsEnabled="False"><TextBlock Text="↶" FontSize="21" /></Button>
                        <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="OnRedoClick" ToolTip="Refazer" IsEnabled="False"><TextBlock Text="↷" FontSize="21" /></Button>
                        <Button Style="{StaticResource IconButton}" Click="OnClearClick" ToolTip="Limpar marcações"><Path Data="M5,7 L19,7 M9,7 L10,4 L14,4 L15,7 M8,9 L9,20 L15,20 L16,9 M11,10 L11,17 M14,10 L14,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="18" Background="#0C0E15" BorderBrush="#282C3B" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="ImageScrollViewer"
                                  Background="#0C0E15"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="Both"
                                  PreviewMouseWheel="OnPreviewMouseWheel"
                                  SizeChanged="OnViewportSizeChanged">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <Grid x:Name="EditingSurface" Background="White" SnapsToDevicePixels="True">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                            </Grid.LayoutTransform>
                            <Image x:Name="CapturedImage" Stretch="Fill" SnapsToDevicePixels="True" />
                            <InkCanvas x:Name="InkSurface" Background="Transparent" StrokesReplaced="OnStrokesReplaced" />
                        </Grid>
                        </Grid>
                    </ScrollViewer>
                    <Border x:Name="StatusPill" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="#EE1C2130" BorderBrush="#3A4055" BorderThickness="1" CornerRadius="10" Padding="13,8">
                        <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="OnZoomOutClick" ToolTip="Reduzir zoom">
                        <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" />
                            <Path Data="M5,9 L13,9 M14,14 L21,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas></Viewbox>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="#CDD0DC" FontSize="12" FontWeight="SemiBold" Width="52" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Click="OnZoomInClick" ToolTip="Ampliar zoom">
                        <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" />
                            <Path Data="M5,9 L13,9 M9,5 L9,13 M14,14 L21,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas></Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnFitClick" ToolTip="Ajustar à janela" Margin="7,0,0,0">
                        <Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource FooterButton}" Click="OnCopyClick" Content="Copiar" />
                <Button x:Name="FinishButton" Grid.Column="3" Style="{StaticResource FooterButton}" Background="{StaticResource AccentBrush}" Click="OnFinishClick">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="Concluir" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
