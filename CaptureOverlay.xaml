<Window x:Class="PrintFreeTool.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintFreeTool"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        KeyDown="OnKeyDown"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded">
    <Grid Background="#73090B12">
        <Canvas x:Name="SelectionCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OnMouseLeftButtonDown"
                MouseMove="OnMouseMove"
                MouseLeftButtonUp="OnMouseLeftButtonUp"
                MouseRightButtonDown="OnMouseRightButtonDown">
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    CornerRadius="3"
                    BorderThickness="2"
                    Background="#12FFFFFF">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4CC9F0" Offset="0" />
                        <GradientStop Color="#A855F7" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#4CC9F0" BlurRadius="8" ShadowDepth="0" Opacity="0.65" />
                </Border.Effect>
            </Border>

            <Border x:Name="DimensionBadge"
                    Visibility="Collapsed"
                    Background="#ED141722"
                    BorderBrush="#3A4055"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="9,5"
                    IsHitTestVisible="False">
                <TextBlock x:Name="DimensionText"
                           Text="0 × 0 px"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,26,0,0"
                Padding="18,10"
                Background="#EE141722"
                BorderBrush="#383D50"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Border Width="25" Height="25" CornerRadius="7" Margin="0,0,10,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4CC9F0" />
                            <GradientStop Color="#A855F7" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="✦" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                </Border>
                <TextBlock Text="Arraste para selecionar uma área"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="   •   Esc ou botão direito cancela"
                           Foreground="#D0FFFFFF"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
