<Window x:Class="PrintFreeTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do PrintFreeTool"
        Width="520" Height="585"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4CC9F0" Offset="0" />
            <GradientStop Color="#6366F1" Offset="0.55" />
            <GradientStop Color="#A855F7" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#A9ADC1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#292D3D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCardButton" TargetType="Button">
            <Setter Property="Height" Value="86" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1B1E2B" />
            <Setter Property="BorderBrush" Value="#34394D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#202332" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#6366F1" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="#141722" BorderBrush="#303448" BorderThickness="1" CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="20,0,16,0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M19.14,12.94 C19.18,12.64 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.18,9.46 C21.36,9.32 21.41,9.06 21.29,8.85 L19.35,5.49 C19.23,5.28 18.98,5.2 18.76,5.28 L16.35,6.25 C15.86,5.87 15.31,5.55 14.72,5.32 L14.36,2.75 C14.33,2.52 14.13,2.35 13.89,2.35 L10.11,2.35 C9.87,2.35 9.67,2.52 9.64,2.75 L9.28,5.32 C8.69,5.56 8.14,5.87 7.65,6.25 L5.24,5.28 C5.02,5.2 4.77,5.28 4.65,5.49 L2.71,8.85 C2.59,9.06 2.64,9.32 2.82,9.46 L4.87,11.06 C4.82,11.36 4.8,11.68 4.8,12 C4.8,12.32 4.82,12.64 4.87,12.94 L2.82,14.54 C2.64,14.68 2.59,14.94 2.71,15.15 L4.65,18.51 C4.77,18.72 5.02,18.8 5.24,18.72 L7.65,17.75 C8.14,18.13 8.69,18.45 9.28,18.68 L9.64,21.25 C9.67,21.48 9.87,21.65 10.11,21.65 L13.89,21.65 C14.13,21.65 14.33,21.48 14.36,21.25 L14.72,18.68 C15.31,18.44 15.86,18.13 16.35,17.75 L18.76,18.72 C18.98,18.8 19.23,18.72 19.35,18.51 L21.29,15.15 C21.41,14.94 21.36,14.68 21.18,14.54 Z M12,15.3 C10.18,15.3 8.7,13.82 8.7,12 C8.7,10.18 10.18,8.7 12,8.7 C13.82,8.7 15.3,10.18 15.3,12 C15.3,13.82 13.82,15.3 12,15.3 Z" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Configurações" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Personalize sua experiência" Foreground="#858AA0" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource TitleButton}" Click="OnCancelClick" VerticalAlignment="Center" ToolTip="Fechar">
                    <Path Data="M2,2 L10,10 M10,2 L2,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="11" Height="11" Stretch="Fill" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="32,12,32,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Captura de região sem editor" Foreground="#F5F6FA" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Esse atalho seleciona, copia e salva imediatamente." Foreground="#8F94A8" FontSize="12" Margin="0,7,0,14" />

                <Button x:Name="RecorderButton" Grid.Row="2" Height="86" Click="OnRecordClick" Background="#1B1E2B" BorderBrush="#34394D" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RecorderChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RecorderChrome" Property="BorderBrush" Value="#6366F1" />
                                    <Setter TargetName="RecorderChrome" Property="Background" Value="#202332" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ATALHO ATUAL" Foreground="#73798E" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="HotkeyText" Text="Win  +  Shift  +  S" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="#282C3C" CornerRadius="10" VerticalAlignment="Center">
                            <Path Data="M4,15 L4,20 L9,20 M20,9 L20,4 L15,4 M19,5 L13,11 M5,19 L11,13" Stroke="#8B91A7" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="18" Height="18" />
                        </Border>
                    </Grid>
                </Button>

                <StackPanel Grid.Row="3" Margin="4,13,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#6366F1" VerticalAlignment="Top" Margin="0,5,8,0" />
                        <TextBlock x:Name="HintText" Text="O atalho precisa incluir Ctrl, Alt, Shift ou Win." Foreground="#7D8398" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="Win + Shift + E abre o editor  •  Win + Shift + A captura a janela ativa." Foreground="#696F84" FontSize="11" Margin="14,6,0,0" />
                </StackPanel>

                <Button Grid.Row="4" Style="{StaticResource SettingsCardButton}" Margin="0,20,0,0" Click="OnConfigurePrintScreenClick">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#242A3C" VerticalAlignment="Center">
                            <Viewbox Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3,4 L21,4 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21" Stroke="#7C83FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CONFIGURAR PRINT SCREEN" Foreground="#73798E" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="PrintScreenSummaryText" Text="Todas as telas" Foreground="#F0F1F6" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                        <Path Grid.Column="2" Data="M8,4 L14,10 L8,16" Stroke="#7F8599" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="14" Stretch="Fill" VerticalAlignment="Center" Margin="10,0,4,0" />
                    </Grid>
                </Button>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ActionButton}" Background="#222635" Content="Cancelar" Click="OnCancelClick" />
                    <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="Salvar alterações" Click="OnSaveClick" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
